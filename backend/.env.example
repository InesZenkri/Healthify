# Copy to .env, replace the placeholders, and keep .env out of git.
DB_NAME=healthify_local
DB_USER=healthify_local
DB_PASSWORD=replace_with_a_new_local_database_password
DB_URL=jdbc:postgresql://localhost:5432/healthify_local
OPENAI_API_KEY=replace_with_your_new_openai_key
GITHUB_CLIENT_ID=replace_with_your_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_your_new_github_oauth_client_secret
# The original demo deletes and recreates tables at startup. Local test data only.
SPRING_JPA_HIBERNATE_DDL_AUTO=create-drop
OPENAI_MODEL=gpt-3.5-turbo
# Compose is started explicitly in the README, not again by Spring Boot.
SPRING_DOCKER_COMPOSE_ENABLED=false
